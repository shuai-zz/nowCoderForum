# Database
MYSQL_USERNAME=forum
MYSQL_PASSWORD=forum

# Mail (QQ 邮箱示例；需要在邮箱设置里开 SMTP 并生成授权码)
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-authorization-code

# File upload directory
UPLOAD_PATH=/tmp/nowcoder-forum-upload

# Logs directory (logback-spring.xml 默认值；无需可删)
LOG_PATH=/tmp/nowcoder-forum-logs

# Captcha: kaptcha（默认，图形）或 tencent（腾讯云行为验证）
CAPTCHA_PROVIDER=kaptcha

# Tencent captcha（仅 provider=tencent 时需要）
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_CAPTCHA_APP_ID=0
# TENCENT_CAPTCHA_APP_SECRET_KEY=
